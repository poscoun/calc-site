{
  // Cloudflare Workers 정적 자산 배포 설정.
  // `npm run build`가 만든 out/ 폴더를 그대로 올린다 (서버 코드 없음, OpenNext 불필요).
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "calc-site",
  "compatibility_date": "2026-11-01",
  "assets": {
    "directory": "./out",
    "not_found_handling": "404-page"
  }
}
